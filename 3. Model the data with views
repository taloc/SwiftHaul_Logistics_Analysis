-- Create a view for on-time rate by carrier and month (on-time shipments / total shipments) 35.29 MB when run.

CREATE OR REPLACE VIEW `lab16499377-1788299418.swifthaul.on_time_by_carrier_month` AS
SELECT
    carrier,
    DATE_TRUNC(ship_date, MONTH) AS ship_month,
    COUNT(*) AS total_shipments,
    COUNTIF(on_time = TRUE) AS on_time_shipments,
    ROUND(
        100 * COUNTIF(on_time = TRUE) / COUNT(*),
        2
    ) AS on_time_rate_pct
FROM `lab16499377-1788299418.swifthaul.shipments`
WHERE ship_date IS NOT NULL
GROUP BY
    ship_month,
    carrier
ORDER BY 
    carrier,
    ship_month
    ;

-- Create a view for cost per lane (average freight_cost_usd grouped by origin_region to destination_region).
CREATE OR REPLACE VIEW `lab16499377-1788299418.swifthaul.average_cost_per_lane` AS
SELECT 
  origin_region AS origin,
  destination_region AS destination,
  CONCAT (origin_region, ' -> ', destination_region) AS lane,
  ROUND (AVG (freight_cost_usd), 2) AS average_cost,
  COUNT (*) AS shipments_per_lane
FROM `lab16499377-1788299418.swifthaul.shipments`
  GROUP BY
    origin_region,
    destination_region
  ORDER BY average_cost DESC;

-- Create a materialized view for cost per lane but for only delayed deliveries.
CREATE MATERIALIZED VIEW `lab16499377-1788299418.swifthaul.delayed_average_cost` AS
SELECT 
  origin_region AS origin,
  destination_region AS destination,
  AVG (freight_cost_usd) AS average_cost,
  COUNT (*) AS shipments_per_lane
FROM `lab16499377-1788299418.swifthaul.shipments`
  WHERE on_time IS FALSE
  GROUP BY
    origin_region,
    destination_region
  ;
