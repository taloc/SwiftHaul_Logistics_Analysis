-- Create an external table as carrier_rates from google storage
CREATE OR REPLACE EXTERNAL TABLE `lab16499377-1788299418.swifthaul.carrier_rates`
OPTIONS (
    format = 'CSV',
    skip_leading_rows = 1,
    uris = ['gs://swifthaul_ry/carrier_rates.csv']);

-- This query joins the shipments table to the carrier_rate table, but it is not optimized.
SELECT  *
FROM `lab16499377-1788299418.swifthaul.shipments` AS s
JOIN `lab16499377-1788299418.swifthaul.carrier_rates` AS c
ON s.carrier = c.carrier;

